# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=whatsapp_saas
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# WhatsApp / Baileys
WA_MAX_QR_ATTEMPTS=5
WA_QR_TIMEOUT_MS=20000
WA_RECONNECT_MAX_RETRIES=10
WA_RECONNECT_BASE_DELAY_MS=2000
WA_RECONNECT_MAX_DELAY_MS=60000
WA_SESSION_RECOVERY_DELAY_MS=2000
WA_HEALTH_CHECK_INTERVAL_MS=30000
WA_MAX_CONCURRENT_SESSIONS=50
WA_BROWSER_NAME=WhatsApp SaaS Platform

# Queue (pg-boss)
QUEUE_SCHEMA=pgboss
QUEUE_MONITOR_INTERVAL=30
QUEUE_ARCHIVE_AFTER=43200
QUEUE_DELETE_AFTER=604800

# OTP Login (WhatsApp)
OTP_EXPIRY_SECONDS=300               # OTP validity in seconds (default 5 min)
OTP_MAX_ATTEMPTS=3                   # Max wrong OTP attempts before lockout
OTP_RATE_LIMIT_WINDOW=600            # Rate limit window in seconds (default 10 min)
OTP_RATE_LIMIT_MAX=3                 # Max OTP requests per phone per window
OTP_LENGTH=6                         # OTP digit length
OTP_MESSAGE_TEMPLATE=Your verification code is: {otp}. Valid for {minutes} minutes. Do not share this code.
